# ============================================================
#  Unity 6 프로젝트용 .gitignore
#  올라가야 하는 것: Assets/, Packages/, ProjectSettings/, .meta 전부
#  올라가면 안 되는 것: Library/, Temp/, 빌드 결과물, 개인 설정
#  참고: github/gitignore 의 Unity.gitignore + 팀 규칙
# ============================================================

# ---------- Unity 가 다시 만들어 주는 폴더 (절대 커밋 금지) ----------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
.utmp/

# ---------- 자동 생성 프로젝트 파일 ----------
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.log
sysinfo.txt
ExportedObj/
.consulo/
.gradle/

# Unity 가 만든 위 파일들의 .meta
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---------- 에디터 / IDE ----------
.vs/
.vscode/
.idea/
.vsconfig
/[Aa]ssets/Plugins/Editor/JetBrains*
/[Aa]ssets/[Aa]ssetStoreTools*

# ---------- 빌드 결과물 ----------
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta
crashlytics-build.properties

# Addressables / StreamingAssets 자동 생성물
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
/[Ss]erver[Dd]ata/

# ---------- 운영체제 잡파일 ----------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*~
*.swp

# ---------- 이 저장소 전용 ----------
# 개인 설정 (이니셜 등) - 사람마다 다르므로 공유하지 않는다
tools/dev.config

# 임시 작업 폴더
/_scratch/
/_to_delete/
