# ============================================================
#  Unity 6 프로젝트용 .gitignore
#  올라가야 하는 것: Assets/, Packages/, ProjectSettings/, .meta 전부
#  올라가면 안 되는 것: Library/, Temp/, 빌드 결과물, 개인 설정
# ============================================================

# ---------- Unity 가 다시 만들어 주는 폴더 ----------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity Package Manager 캐시
/[Aa]ssets/[Aa]ssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# ---------- 에디터 / IDE ----------
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb.meta
*.opendb
*.VC.db
.consulo/

# ---------- 빌드 결과물 ----------
*.apk
*.aab
*.unitypackage
*.app
ExportedObj/
crashlytics-build.properties
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Addressables
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Ss]erver[Dd]ata/

# ---------- 운영체제 잡파일 ----------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*~
*.swp

# ---------- 이 저장소 전용 ----------
# 개인 설정 (이니셜 등) - 사람마다 다르므로 공유하지 않는다
tools/dev.config

# 임시 작업 폴더
/_scratch/
/_to_delete/
